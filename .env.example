# ============================================================
# RA A1 Enterprises — environment template
# Copy to `.env.local` and fill in real values. NEVER put real
# secrets in this file: it is the one env file meant to be shared.
# ============================================================

# ── Firebase Admin SDK (server-only, required) ──────────────
# From Firebase Console → Project Settings → Service Accounts →
# Generate new private key. Take these three fields out of the JSON.
# Keep the \n escapes and the surrounding double quotes.
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"

# ── NextAuth (admin login, required) ────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"

# ── Site (optional) ─────────────────────────────────────────
# Only needed for local dev or a custom domain. On Vercel, leave this
# unset and src/lib/siteUrl.ts falls back to the deployment domain
# automatically, so sitemap.xml and robots.txt can never emit localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Analytics (optional) ────────────────────────────────────
# Google Analytics measurement ID, e.g. G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID="G-K73NQCZ7JQ"

# ── Search Console (optional) ───────────────────────────────
# The meta-tag token from Search Console → Settings → Ownership
# verification → HTML tag. A ~43-char string — NOT a GA "G-..." ID.
# Leave empty if you verified with the HTML file in /public instead.
GOOGLE_SITE_VERIFICATION=""
